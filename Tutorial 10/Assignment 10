#include <iostream>
using namespace std;

int main()
{
    int a, b;

    cout << "Enter two values: ";
    cin >> a >> b;

    try
    {
        if (b == 0)
            throw b;

        int c = a / b;
        cout << "Result: " << c;
    }
    catch (int x)
    {
        cout << "Exception: Division by zero is not permitted.";
    }

    return 0;
}
